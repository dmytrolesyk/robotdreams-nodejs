{
  "name": "robotdreams-nodejs",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "pnpm typecheck && rolldown -c",
    "node:dev": "node --watch src/index.ts",
    "stack:up:override": "docker compose up -d --build --wait",
    "stack:up": "docker compose -f compose.yaml up -d --build --wait",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v",
    "bootstrap": "./bootstrap.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "rolldown": "^1.2.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
